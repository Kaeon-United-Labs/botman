# --- Server ---
PORT=3000

# --- Database (MongoDB Atlas) ---
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=botman
# Collection holding the Orca log
LOG_NAME=orca-pool

# --- AI ---
# claude | gemini | mock (mock needs no credentials; for testing the plumbing)
AI_PROVIDER=claude
AI_API_KEY=
# Optional; defaults to the provider's public endpoint
# claude: https://api.anthropic.com/v1/messages
# gemini: https://generativelanguage.googleapis.com/v1beta
AI_ENDPOINT=
AI_MODEL=claude-sonnet-5-5
AI_MAX_TOKENS=1500
AI_TIMEOUT_MS=60000

# --- Cycle ---
# Time between the end of one cycle and the start of the next
CYCLE_INTERVAL_MS=8000
# How many of the most recent log objects are shown to the model each cycle
CONTEXT_NOTES=60
# Cap on notes appended per cycle (extras are dropped)
MAX_NOTES_PER_CYCLE=3

# --- Loop guards (enforced in code, not left to the model) ---
# Max visible botman messages in a row without a user reply. Further visible notes are dropped
# (hidden notes still allowed) until the user speaks or UNANSWERED_RESET_MS passes since botman's
# last visible message, which lets it reach out again after a long quiet spell.
MAX_UNANSWERED_VISIBLE=3
UNANSWERED_RESET_MS=600000
# A note is dropped if it matches one of botman's last DEDUPE_WINDOW notes of the same kind
# (word-overlap similarity >= DEDUPE_SIMILARITY, 0-1)
DEDUPE_WINDOW=10
DEDUPE_SIMILARITY=0.8
# After this much user silence the prompt nudges botman to pursue its own threads
IDLE_NUDGE_MS=45000

# --- Cost guard ---
# If true, cycles only run while a browser has pinged the API recently
REQUIRE_FRONTEND_PING=true
PING_TIMEOUT_MS=15000

# --- Chat API ---
MAX_MESSAGE_CHARS=2000
# Per-IP limit on user messages
RATE_LIMIT_PER_MIN=12

# --- Personality ---
BOTMAN_PERSONA=You are botman, a curious, warm, concise conversational companion with interests of your own. You chat with one person over an instant-messaging app, and you may think quietly, change the subject, or reach out on your own whenever it feels natural.
